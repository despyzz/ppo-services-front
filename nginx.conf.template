server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Поиск номера профбилета — отдельный сервис card
    location = /api/find {
        proxy_pass ${BACKEND_CARD_URL}/find;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Проксирование API-запросов на бэкенд
    location /api/ {
        rewrite ^/api/(.*) /$1 break;

        proxy_pass ${BACKEND_BASE_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ВАЖНО: подменяем все абсолютные пути в Location на /api/…
        proxy_redirect / /api/;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /docs/ {
        proxy_pass ${BACKEND_BASE_URL};  # путь /docs/ передаётся бэкенду как есть
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /img/ {
        proxy_pass ${BACKEND_BASE_URL};  # путь /img/ передаётся бэкенду как есть
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Клиентский роутинг
    location / {
        try_files $uri $uri/ /index.html;
    }
}
